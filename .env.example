# ---------------------------------------------------------------------------
# FRONTEND ENV (Vite) — copy to .env and fill in. Only VITE_* vars are exposed
# to the browser. NEVER put service-role keys or client secrets here.
# ---------------------------------------------------------------------------

# Supabase project (Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Microsoft / Azure AD app (public client id + SPA redirect for OAuth)
VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_MS_TENANT_ID=common
VITE_MS_REDIRECT_URI=http://localhost:5173/ms-auth-callback

# Cloudflare Turnstile SITE key (public — safe in the browser). Optional: the app
# falls back to the project's live widget key if unset. The Turnstile SECRET key
# is NOT set here — it goes into the Supabase dashboard (Auth -> Attack Protection).
VITE_TURNSTILE_SITE_KEY=0xAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ---------------------------------------------------------------------------
# Edge Function secrets are NOT set here. Set them with the Supabase CLI:
#   supabase secrets set NVIDIA_API_KEY=... AZURE_CLIENT_SECRET=... etc.
# See README.md "Environment Variables" for the full list.
# ---------------------------------------------------------------------------
