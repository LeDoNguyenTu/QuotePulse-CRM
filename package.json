{
  "name": "sales-outreach-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sales automation & outreach tool: HubSpot ingestion, KYC enrichment, NVIDIA OCR, and Outlook/Microsoft Graph bulk email on Supabase + Vite/React.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "postinstall": "patch-package",
    "test:storage-recovery": "vitest run scripts/recover-supabase-storage.test.ts"
  },
  "dependencies": {
    "@hiraokahypertools/pst-extractor": "^0.5.0-alpha.2",
    "@kenjiuno/decompressrtf": "0.1.4",
    "@kenjiuno/msgreader": "1.28.0",
    "@noble/hashes": "^2.4.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-table": "^8.20.5",
    "@vercel/analytics": "^2.0.1",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "18.3.1",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "30.1.2",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.28",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
